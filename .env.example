# LLM
# LLM provider. "openai_compat" = Groq (free tier), Ollama, Together, Mistral... ; "anthropic" = Claude.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
# Free key from console.groq.com (no card). GROQ_API_KEY is accepted as an alias.
LLM_API_KEY=
# Tried in order on rate limits or repeated invalid output
LLM_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
LLM_REASONING_EFFORT=medium
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Database (Supabase -> Project Settings -> Database -> Connection string, URI)
DATABASE_URL=
# Which tenant this process works for. Leave unset for the default tenant (Zypher).
# TENANT_ID=00000000-0000-0000-0000-000000000001

# Approval / notifications
TELEGRAM_BOT_TOKEN=
# comma-separated Telegram user IDs allowed to approve
TELEGRAM_ALLOWED_USER_IDS=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Notion CRM
NOTION_TOKEN=
NOTION_CRM_DATABASE_ID=

# Email sending (use a SEPARATE cold-email domain)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=Muhammed Hasheem
SENDER_EMAIL=
SENDER_POSTAL_ADDRESS=
OPT_OUT_LINE=
UNSUBSCRIBE_BASE_URL=

# Sending policy
MAX_EMAILS_PER_MAILBOX_PER_DAY=20
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
AUTONOMY_LEVEL=0

# WhatsApp Business API (Phase 4)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Lead sources (optional)
APOLLO_API_KEY=
