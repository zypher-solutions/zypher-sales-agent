# Copy to .env and fill in. Never commit .env, never paste its values into a chat.
# Every setting the code reads is listed once (tests/test_env_example.py checks this). Lines starting with "# KEY="
# are optional: the default shown is what you get when the line is left out.

# ---- LLM ----
# "openai_compat" = Groq (free tier), Ollama, Together, Mistral... ; "anthropic" = Claude.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
# Free key from console.groq.com (no card). GROQ_API_KEY is accepted as an alias.
LLM_API_KEY=
# Tried in order on rate limits or repeated invalid output
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_REASONING_EFFORT=medium
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# LLM_MAX_TOKENS=16000

# ---- Database ----
# Supabase -> Connect -> Session pooler URI (port 5432). The session pooler matters: the "only one copy runs"
# lock needs it, and it works over IPv4 (servers often have no IPv6).
DATABASE_URL=
# Which tenant this process works for. Leave unset for the default tenant (Zypher).
# TENANT_ID=00000000-0000-0000-0000-000000000001

# ---- Lead sourcing: Google Maps via Apify (console.apify.com -> Settings -> API & Integrations) ----
APIFY_TOKEN=

# ---- Telegram approvals ----
TELEGRAM_BOT_TOKEN=
# comma-separated Telegram user IDs allowed to approve
TELEGRAM_ALLOWED_USER_IDS=
# Optional: a group chat id (negative number) so partners in the group see and approve cards
# TELEGRAM_APPROVAL_CHAT_ID=
# Never more than this many cards waiting for your review at once; the rest queue quietly
MAX_OPEN_CARDS=10

# ---- Sender identity (the signature on every email) ----
SENDER_NAME=
SENDER_TITLE=
SENDER_EMAIL=
# Optional lines shown next to the email in the signature
SENDER_PHONE=
SENDER_WEBSITE=
# Small print under the signature (your confidentiality notice). Optional.
SENDER_DISCLAIMER=
# The line before your name (default: Best regards,)
SENDER_SIGN_OFF=
# A small PNG logo (about 400 px wide, under 20 KB) shown under the signature. Empty = no logo.
SENDER_LOGO_PATH=
SENDER_POSTAL_ADDRESS=
OPT_OUT_LINE=

# ---- Sending (run `zypher.ps1 preflight` before the first real send) ----
# Master switch. false = nothing is ever emailed, whatever else is set.
SENDING_ENABLED=false
# While testing, only these recipients can receive email (addresses or domains, comma-separated). Clear to go live.
SEND_ALLOWLIST=
# Mailbox login. MAIL_USER empty = same as SENDER_EMAIL.
MAIL_USER=
MAIL_PASSWORD=
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
# Each sent email is also filed here so it shows in your webmail Sent list
SENT_FOLDER=Sent
# SAVE_SENT_COPY=true
SENDER_TIMEZONE=Asia/Kolkata
# Your own daily cap. Can only lower the built-in warmup ramp (5 a day rising to 15), never raise it.
# DAILY_SEND_CAP=

# ---- Daily drafting inside `start` (the server turns this on; on the laptop you run `zypher.ps1 draft`) ----
DRAFT_SCHEDULE_ENABLED=false
DRAFT_DAILY_LIMIT=5
# 24-hour local time in DRAFT_TIMEZONE. If the agent was down at that time, it catches up later the same day only.
DRAFT_TIME=08:00
DRAFT_DAYS=mon,tue,wed,thu,fri
DRAFT_TIMEZONE=Asia/Kolkata

# ---- Running unattended (Docker on the server) ----
# Folder for heartbeat files. Empty = no heartbeat and no watchdog (laptop). docker-compose.yml sets /data.
# HEARTBEAT_DIR=
# Name shown when a second copy finds this one running ("server", "laptop"). Empty = the computer's name.
# AGENT_HOST_LABEL=
# Healthchecks.io ping URL for this agent (pinged every 5 minutes). Empty = no off-server monitoring.
HEALTHCHECKS_URL=

# ---- Nightly database backup (the `backup` service in docker-compose.yml; not read by the agent) ----
# rclone destination, e.g. b2:zypher-backups/sales-agent. Empty = keep the 14 local copies only.
BACKUP_REMOTE=
# rclone's Backblaze B2 login (an application key limited to the backup bucket)
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
# Healthchecks.io ping URL for the backup job
HEALTHCHECKS_BACKUP_URL=

# ---- Advanced (rarely changed) ----
# ICP_PATH=icp.yaml
