# LLM
# LLM provider. "openai_compat" = Groq (free tier), Ollama, Together, Mistral... ; "anthropic" = Claude.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
# Free key from console.groq.com (no card). GROQ_API_KEY is accepted as an alias.
LLM_API_KEY=
# Tried in order on rate limits or repeated invalid output
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_REASONING_EFFORT=medium
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Database (Supabase -> Project Settings -> Database -> Connection string, URI)
DATABASE_URL=
# Which tenant this process works for. Leave unset for the default tenant (Zypher).
# TENANT_ID=00000000-0000-0000-0000-000000000001

# Lead sourcing: Google Maps via Apify (console.apify.com -> Settings -> API & Integrations)
APIFY_TOKEN=

# Sending (Phase 2). Run `zypher.ps1 preflight` before the first real send.
SENDING_ENABLED=false
# While testing, only these recipients can receive email (addresses or domains, comma-separated). Clear to go live.
SEND_ALLOWLIST=
MAIL_USER=
MAIL_PASSWORD=
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
# Each sent email is also filed here so it shows in your webmail Sent list (SAVE_SENT_COPY=false to turn off)
SENT_FOLDER=Sent
SENDER_TIMEZONE=Asia/Kolkata
# Your own daily cap. Can only lower the built-in warmup ramp (5 a day rising to 15), never raise it.
# DAILY_SEND_CAP=

# Approval / notifications
TELEGRAM_BOT_TOKEN=
# comma-separated Telegram user IDs allowed to approve
TELEGRAM_ALLOWED_USER_IDS=
# Optional: a group chat id (negative number) so partners in the group see and approve cards
# TELEGRAM_APPROVAL_CHAT_ID=
# Never more than this many cards waiting for your review at once; the rest queue quietly
MAX_OPEN_CARDS=10
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Notion CRM
NOTION_TOKEN=
NOTION_CRM_DATABASE_ID=

# Email sending (use a SEPARATE cold-email domain)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=
SENDER_TITLE=
SENDER_EMAIL=
# Optional lines shown next to the email in the signature
SENDER_PHONE=
SENDER_WEBSITE=
# Small print under the signature (your confidentiality notice). Optional.
SENDER_DISCLAIMER=
# The line before your name (default: Best regards,)
SENDER_SIGN_OFF=
# A small PNG logo (about 400 px wide, under 20 KB) shown under the signature. Empty = no logo.
SENDER_LOGO_PATH=
SENDER_POSTAL_ADDRESS=
OPT_OUT_LINE=
UNSUBSCRIBE_BASE_URL=

# Sending policy
MAX_EMAILS_PER_MAILBOX_PER_DAY=20
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
AUTONOMY_LEVEL=0

# WhatsApp Business API (Phase 4)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Lead sources (optional)
APOLLO_API_KEY=
